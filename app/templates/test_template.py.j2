"""
自动生成的API测试文件
生成时间: {{ generated_at }}
项目: {{ project_name }}
用例数: {{ cases | length }}
"""
import pytest
import requests
import uuid

BASE_URL = "{{ base_url }}"


def _unique(value: str) -> str:
    """为字符串值附加随机后缀，避免测试之间的数据冲突"""
    suffix = uuid.uuid4().hex[:6]
    if "@" in value:
        local, domain = value.rsplit("@", 1)
        return f"{local}_{suffix}@{domain}"
    return f"{value}_{suffix}"

{% for case in cases %}


def test_{{case.name | replace("-", "_")}}():
    """
    {{ case.description }}
    分类: {{ case.category }}
    优先级: {{ case.priority | default("medium") }}
    """
    url = f"{BASE_URL}{{ case.url }}"
    headers = {{ case.headers | default({}) | tojson }}
    {% if case.body %}
    payload = {{ case.body | tojson }}
    # 对唯一性字段做随机化，避免测试间数据冲突
    if "username" in payload and isinstance(payload["username"], str) and len(payload["username"]) >= 3:
        payload["username"] = _unique(payload["username"])
    if "email" in payload and isinstance(payload["email"], str) and "@" in payload["email"]:
        payload["email"] = _unique(payload["email"])
    {% else %}
    payload = None
    {% endif %}
    {% if case.query_params %}
    params = {{ case.query_params | tojson }}
    {% else %}
    params = None
    {% endif %}

    response = requests.{{ case.method | lower }}(
        url,
        headers=headers,
        {% if case.method | upper in ["POST", "PUT", "PATCH"] %}
        json=payload,
        {% endif %}
        params=params,
        timeout=10,
    )

    # 状态码断言
    assert response.status_code == {{ case.expected_status }}, \
        f"期望状态码 {{ case.expected_status }}，实际 {response.status_code}，响应: {response.text[:200]}"


{% endfor %}